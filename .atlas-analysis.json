  "keyFeatures": [
    "AI survey generation from a plain-English brief",
    "50 question types across 6 families (closed, scales, grids, ranking, open ends, dates)",
    "13 logic tools: branching, screen-outs, display logic, quotas, carry-forward, loops, piping, scoring, randomization",
    "Real-time collaborative editing with character-level merge",
    "Immutable version-pinned published snapshots for longitudinal tracking",
    "4 distribution channels: link/QR, email campaigns, embed, panel handoff",
    "6 report artefacts: results, response grid, topline, narrative document, methodology, shared link",
    "4 export formats: CSV, Excel, SPSS .sav, data dictionary",
    "AI inline question editing with proposal/accept flow",
    "AI narrated insights from responses",
    "Per-question analytics with percent-of-base calculations",
    "Quota management with crossed cells and live fill tracking",
    "Email campaign delivery tracking (sent, opened, clicked, bounced)"
  ],
  "publicApiSurface": [
    "Survey builder canvas with real-time collaboration",
