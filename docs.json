{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "OnlineSurvey Help",
  "description": "How to build, share and read research surveys with OnlineSurvey. One page for every question type and every logic rule.",
  "colors": {
    "primary": "#BB6440",
    "light": "#D9896A",
    "dark": "#A5563A"
  },
  "logo": {
    "light": "/logo/os-light.svg",
    "dark": "/logo/os-dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#F7F5F2",
      "dark": "#17171F"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Log in",
        "href": "https://app.onlinesurvey.ai/login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://app.onlinesurvey.ai/signup"
    }
  },
